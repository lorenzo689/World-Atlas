{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Edit(/frontend/src/**)",
      "Edit(/frontend/scripts/**)",
      "Edit(/backend/src/**)",
      "Edit(/docs/**)",
      "Bash(npm run verify:fast)",
      "Bash(npm run verify:data)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run audit:map)",
      "Bash(npm run perf)",
      "Bash(npm run data:history:verify)",
      "Bash(npm run data:ww2:verify)",
      "Bash(npm run data:ww2:verify -- --require-external)",
      "Bash(npm run data:detail:verify)",
      "Bash(npm run data:conflicts:verify)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(./mvnw test)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw -B test)",
      "Bash(./mvnw verify)",
      "Bash(./mvnw -B verify)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(npm run verify:fast)",
      "PowerShell(npm run verify:data)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(npm test)",
      "PowerShell(npm test -- *)",
      "PowerShell(npx vitest run *)",
      "PowerShell(./mvnw.cmd test)",
      "PowerShell(./mvnw.cmd test *)",
      "PowerShell(.\\mvnw.cmd test)",
      "PowerShell(.\\mvnw.cmd test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "ask": [
      "Edit(/frontend/perf-budget.json)",
      "Edit(/frontend/scripts/map-audit-baseline.json)",
      "Edit(/backend/src/main/resources/db/migration/**)",
      "Edit(/backend/src/main/java/dev/worldexplorer/common/security/**)",
      "Edit(/backend/src/main/resources/application*.yml)",
      "Edit(/deploy/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/frontend/public/data/**)",
      "Edit(/frontend/scripts/source/**)",
      "Edit(/frontend/scripts/data/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop *)",
      "Bash(git branch -d *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo edit *)",
      "Bash(npm publish *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(docker push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag *)",
      "PowerShell(git rebase *)",
      "PowerShell(git restore *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh release *)",
      "PowerShell(npm publish *)",
      "PowerShell(npm install *)",
      "PowerShell(docker push *)"
    ],
    "deny": [
      "Read(/deploy/.env)",
      "Edit(/.git/**)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git reflog expire *)",
      "Bash(git stash clear *)",
      "Bash(git update-ref -d *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker-compose down -v *)",
      "Bash(docker system prune *)",
      "Bash(docker volume prune *)",
      "Bash(docker image prune *)",
      "Bash(docker builder prune *)",
      "Bash(docker container prune *)",
      "Bash(docker volume rm *)",
      "Bash(gh repo delete *)",
      "Bash(*--dangerously-skip-permissions*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git branch -D *)",
      "PowerShell(docker compose down -v *)",
      "PowerShell(docker system prune *)",
      "PowerShell(docker volume prune *)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
