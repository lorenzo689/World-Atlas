# Copy to deploy/.env and fill in.

# Public address: a domain name gets a free HTTPS certificate automatically; ":80" serves plain HTTP.
SITE_ADDRESS=explorer.example.com
# The same address with scheme - used in e-mail links and for the WebSocket origin check
PUBLIC_URL=https://explorer.example.com

# Generate with:  openssl rand -base64 48
APP_JWT_SECRET=
POSTGRES_PASSWORD=

# Comma-separated e-mail addresses that become ADMIN on sign-up (bootstrap; afterwards use the admin page)
APP_ADMIN_EMAILS=you@example.com

# Outgoing mail for verification and password-reset links (any SMTP server)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_AUTH_MAIL_FROM=World Explorer <no-reply@example.com>

# Image names (built locally by "docker compose build", or pulled from GHCR after the "Publish images" workflow)
BACKEND_IMAGE=world-explorer-backend:latest
WEB_IMAGE=world-explorer-web:latest
