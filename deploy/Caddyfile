# {$SITE_ADDRESS} is a domain (HTTPS via Let's Encrypt) or ":80" for plain HTTP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API, WebSocket (STOMP) and the OpenAPI docs go to the Spring Boot backend
	@backend path /api/* /ws /ws/* /swagger-ui/* /swagger-ui.html /v3/api-docs*
	reverse_proxy @backend backend:8080

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.wikimedia.org https://*.wikipedia.org; font-src 'self' data:; connect-src 'self' https://api.worldbank.org https://en.wikipedia.org wss:; worker-src 'self' blob:; manifest-src 'self'"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
	}

	# hashed bundles and static data can be cached for a long time, the service worker and shell must not
	@immutable path /assets/* /textures/* /flags/* /icons/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@shell path /sw.js /index.html /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	root * /srv
	try_files {path} /index.html
	file_server
}
