{
  "name": "World Explorer",
  "short_name": "Explorer",
  "description": "An interactive 3D atlas with a geography quiz, multiplayer and a personal travel map.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A101A",
  "theme_color": "#0A101A",
  "categories": ["education", "travel", "games"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Geo quiz", "url": "/quiz", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Multiplayer", "url": "/play", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
